{
    "kind": "collectionType",
    "collectionName": "videos",
    "info": {
        "singularName": "video",
        "pluralName": "videos",
        "displayName": "Video",
        "description": "Video updates managed by Communications for the homepage Latest Updates section"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "title",
            "required": true
        },
        "summary": {
            "type": "text",
            "maxLength": 500
        },
        "videoUrl": {
            "type": "string"
        },
        "videoFile": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "videos"
            ]
        },
        "coverImage": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ]
        },
        "publishedDate": {
            "type": "datetime"
        },
        "featured": {
            "type": "boolean",
            "default": false
        }
    }
}
