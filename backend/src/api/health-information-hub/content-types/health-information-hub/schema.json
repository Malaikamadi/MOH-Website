    },
    "underFiveDeathsQuarterly": {
      "type": "component",
      "repeatable": true,
      "component": "hub.quarterly-data"
    },
    "maternalDeathsMonthly": {
      "type": "component",
      "repeatable": true,
      "component": "hub.monthly-data"
    },
    "underFiveDeathsMonthly": {
      "type": "component",
      "repeatable": true,
      "component": "hub.monthly-data"
    },
    "healthCoverage": {
      "type": "component",
      "repeatable": true,
      "component": "hub.health-coverage"
    },
