{
    "kind": "collectionType",
    "collectionName": "leadership_members",
    "info": {
        "singularName": "leadership-member",
        "pluralName": "leadership-members",
        "displayName": "Leadership Member",
        "description": "Ministry leadership: Ministers, deputies, CMO, and executive team"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "name": {
            "type": "string",
            "required": true
        },
        "position": {
            "type": "string",
            "required": true
        },
        "credentials": {
            "type": "string"
        },
        "bio": {
            "type": "richtext"
        },
        "image": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": ["images"]
        },
        "order": {
            "type": "integer",
            "default": 0
        },
        "isMinister": {
            "type": "boolean",
            "default": false
        },
        "stats": {
            "type": "component",
            "repeatable": true,
            "component": "shared.stat-item"
        },
        "education": {
            "type": "string"
        },
        "experience": {
            "type": "string"
        },
        "focusAreas": {
            "type": "string"
        }
    }
}
