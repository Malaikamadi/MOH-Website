# Strapi Backend API URL
# For local development:
VITE_API_URL=http://localhost:1337
# For production (set in Vercel Dashboard → Settings → Environment Variables):
# VITE_API_URL=https://your-strapi-instance.example.com

# Optional: show one demo card in Latest Updates when Strapi has no articles (default: off)
# VITE_UPDATES_DEMO_FALLBACK=true
